# Submify settings. Restart after editing: sudo systemctl restart submify
POSTGRES_PASSWORD=@SECRET@
JWT_SECRET=@SECRET@
SUBMIFY_PORT=2512
# 127.0.0.1 keeps Submify reachable only from this machine. Use 0.0.0.0 to open it to your network
# (put it behind HTTPS before exposing it to the internet).
SUBMIFY_BIND_IP=127.0.0.1
# Origins allowed to call the API directly, comma-separated. Add your domain when you use one.
ALLOWED_ORIGINS=http://localhost:2512,http://127.0.0.1:2512
# Set true only behind real HTTPS.
AUTH_COOKIE_SECURE=false
