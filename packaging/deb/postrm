#!/bin/sh
set -e
systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$1" = purge ]; then
  echo "submify: your data stays in Docker volumes (submify_pg_data, submify_uploads) and your settings and generated passwords in /etc/submify/submify.env, so a later reinstall picks up where you left off. To delete everything for good: sudo docker compose --project-name submify down -v ; sudo rm -rf /etc/submify" >&2
fi
exit 0
